# PostgreSQL (used by docker-compose.prod.yml)
POSTGRES_USER=sahikim
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sahikim

# Backend database connection (host `postgres` is the Docker service name)
DATABASE_URL=postgresql://sahikim:change-me@postgres:5432/sahikim

# Frontend build-time Socket.IO URL (embedded in Vite bundle)
VITE_SOCKET_URL=https://sahikim.furkanerg.com

# Comma-separated allowed origins for HTTP API and Socket.IO (defaults to * when unset)
CORS_ORIGINS=https://sahikim.furkanerg.com,http://localhost:5173
